---
import "../styles/global.css";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import { Font } from "astro:assets";
import { getImage } from "astro:assets";
import FullFrame1 from "@/assets/images/FullFrame.png";

// Precompute the primary LCP candidate image (first project card)
const firstProjectLcpImage = await getImage({
  src: FullFrame1,
  width: 350,
  height: 270,
  format: "webp",
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/assets/logos/logo.svg" />
    <title>DaanFr | Full-Stack Development & DevOps Solutions</title>
    <link
      rel="preload"
      as="image"
      href={firstProjectLcpImage.src}
      imagesizes="(min-width: 640px) 351px, 296px"
      fetchpriority="high"
      type="image/webp"
    />
    <meta
      content="DaanFr: Professional software development company specializing in Full-Stack Development, DevOps, Cloud, and AI/ML. Explore our projects, capabilities, and client testimonials."
    />
    <meta
      content="DaanFr, software development, web development, full-stack, DevOps, cloud, AI, ML, React, Next.js, NestJS, Django"
    />
    <meta name="author" content="DaanFr" />
    <!-- Open Graph / Facebook -->
    <meta content="DaanFr | Full-Stack Development & DevOps Solutions" />
    <meta
      content="Professional software development company specializing in Full-Stack Development, DevOps, Cloud, and AI/ML projects."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://farhan.info/" />
    <meta
      property="og:image"
      content="https://farhan.info/assets/images/profile.png"
    />
    <!-- Twitter -->
    <meta name="twitter:creator" content="@daanfr" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta content="DaanFr | Full-Stack Development & DevOps Solutions" />
    <meta
      content="Professional software development company specializing in Full-Stack Development, DevOps, Cloud, and AI/ML projects."
    />
    <meta
      name="twitter:image"
      content="https://farhan.info/assets/images/profile.png"
    />
    <script is:raw>
      (function (c, l, a, r, i, t, y) {
        c[a] =
          c[a] ||
          function () {
            (c[a].q = c[a].q || []).push(arguments);
          };
        t = l.createElement(r);
        t.async = 1;
        t.src = "https://www.clarity.ms/tag/" + i;
        y = l.getElementsByTagName(r)[0];
        y.parentNode.insertBefore(t, y);
      })(window, document, "clarity", "script", "shkxymcvd2");
    </script>
    <!-- Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "DaanFr",
        "url": "https://farhan.info/",
        "logo": "https://farhan.info/assets/logos/logo.svg",
        "description": "Professional software development company specializing in Full-Stack Development, DevOps, Cloud, and AI/ML solutions.",
        "foundingDate": "2019",
        "knowsAbout": [
          "JavaScript",
          "TypeScript",
          "Python",
          "React",
          "Next.js",
          "NestJS",
          "Django",
          "DevOps",
          "Cloud Computing",
          "AWS",
          "Azure",
          "Kubernetes",
          "CI/CD",
          "AI/ML"
        ],
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Lahore",
          "addressCountry": "PK"
        }
      }
    </script>
    <Font cssVariable="--font-inter" preload />
    <style>
      body {
        font-family: var(--font-inter);
      }
    </style>
  </head>
  <body
    class="relative px-[17.5px] sm:px-[39px] py-[24px] sm:py-[32px] mx-[14.3px] sm:mx-[30px] md:mx-[50px] lg:mx-[100px] dashed-left-right-border max-w-[1440px] items-center xl:mx-auto"
  >
    <Navbar />
    <slot />
    <Footer />
  </body>
</html>
