---
import SocialLink from "../social/SocialLink.astro";
import ConnectButton from "../common/ConnectButton.astro";
import GitHubImage from "@/assets/icons/github.svg";
import LinkedinImage from "@/assets/icons/color-in.svg";
import envelopeIcon from "@/assets/icons/hero-envelope-icon.svg";

const isUpworkBuild = import.meta.env.VITE_BUILD_TYPE === "UPWORK";

const AllSocialLinks = [
  {
    href: "https://github.com/daanyal-rhaila-memon",
    icon: GitHubImage,
    label: "GitHub",
    upworkSafe: true,
  },
  {
    href: "https://www.linkedin.com/in/daanyal-rhaila-memon/",
    icon: LinkedinImage,
    label: "LinkedIn",
    upworkSafe: false,
  },
];

const socials = isUpworkBuild
  ? AllSocialLinks.filter((social) => !!social.upworkSafe)
  : AllSocialLinks;
---

<header class="flex items-center gap-3 sm:gap-5 md:gap-6 shrink-0">
  {
    socials.map((link) => {
      return (
        <SocialLink
          href={link.href}
          icon={link.icon}
          label={link.label}
          linkClass="flex items-center space-x-2"
          iconClass="w-5 h-5 sm:w-6 sm:h-6"
          labelClass="hidden lg:block text-[0.9rem]"
          isloading={true}
        />
      );
    })
  }
  <ConnectButton
    text="Let's Talk Strategy"
    icon={envelopeIcon}
    class="flex items-center gap-1.5 sm:gap-2 rounded-full bg-gradient-vertical px-2.5 py-1.5 sm:px-3.5 sm:py-3"
    iconClass="h-3 w-3.5 sm:h-3.5 sm:w-4 md:h-4 md:w-4 lg:h-5 lg:w-5 shrink-0"
    textClass="text-[10px] sm:text-[12px] md:text-[14px] lg:text-[16px] font-medium whitespace-nowrap leading-none"
    isLoading={true}
  />
</header>
