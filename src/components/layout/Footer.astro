---
import { Image } from "astro:assets";
import logo from "@/assets/logos/logo.webp";

const isUpworkBuild = import.meta.env.VITE_BUILD_TYPE === "UPWORK";
const year = new Date().getFullYear();

const homeLinks = [
  { href: "#home", label: "Home" },
  { href: "#projects", label: "Projects" },
  { href: "#skills", label: "Skills" },
  { href: "#about", label: "About" },
  { href: "#contact", label: "Contact" },
];
---

<footer
  class=" flex flex-col items-center gap-[20px] sm:gap-[24px] lg:px-[21px] py-12"
>
  <!-- Mobile: stacked & centered. Desktop: 3-col with sections truly centered -->
  <div
    class="grid w-full grid-cols-1 gap-[20px] sm:gap-[16px] md:grid-cols-[1fr_auto_1fr] md:items-center"
  >
    <!-- Logo + year -->
    <div
      class="flex items-center gap-[10px] sm:gap-[12px]"
    >
      <a href="#home" class="shrink-0" aria-label="Home">
        <Image
          src={logo}
          alt="Logo"
          class="h-6 w-6"
          loading="lazy"
        />
      </a>
      <p class="text-[10px] sm:text-[14px] text-textSecondary">
        © {year} All rights reserved
      </p>
    </div>

    <!-- Sections — centered -->
    <nav
      class="flex flex-wrap items-center justify-center gap-x-[14px] gap-y-[8px] sm:gap-x-[20px] md:justify-self-center"
      aria-label="Home sections"
    >
      {
        homeLinks.map((link) => (
          <a
            href={link.href}
            class="text-[12px] sm:text-[14px] font-medium text-textSecondary transition-colors duration-200 hover:text-textPrimary"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <!-- Credits -->
    {
      !isUpworkBuild ? (
        <div class="flex flex-wrap items-center justify-center gap-x-1 text-center text-[12px] sm:text-[14px] leading-[18px] text-textSecondary md:justify-end md:justify-self-end md:text-right">
          <span>Designed by&nbsp;</span>
          <a
            href="https://www.linkedin.com/in/saif-ullah-khan-740178228/"
            target="_blank"
            rel="noopener noreferrer"
            class="font-bold underline text-textPrimary"
          >
            Saif Ullah Khan
          </a>
          <span class="font-bold text-textPrimary">&nbsp;&&nbsp;</span>
          <a
            href="https://www.linkedin.com/in/areeba-rahila-memon/"
            target="_blank"
            rel="noopener noreferrer"
            class="font-bold underline text-textPrimary"
          >
            Areeba (Rahila) Memon
          </a>
        </div>
      ) : (
        <div class="hidden md:block" aria-hidden="true" />
      )
    }
  </div>
</footer>
