---
import { Image } from "astro:assets";
import logo from "@/assets/logos/logo.svg";
import Header from "./Header.astro";
---

<nav
  class="sticky top-0 z-40 w-full px-[17.5px] sm:px-[39px] pt-3 sm:pt-4"
>
  <div
    class="nav-glass flex justify-between items-center gap-2 sm:gap-3 px-2.5 py-1.5 sm:px-3 sm:py-2 rounded-full"
  >
    <div class="flex items-center space-x-2 min-w-0 ml-2">
      <Image
        src={logo}
        alt="Logo"
        class="h-6 w-6 sm:h-7 sm:w-7 shrink-0"
        loading="eager"
      />
      <span class="text-[12px] sm:text-[14px] truncate"
        >Code by Daanyal Rhaila</span
      >
    </div>
    <Header />
  </div>
</nav>

<style>
  .nav-glass {
    background: rgba(255, 255, 255, 0.45);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    box-shadow:
      0 8px 32px rgba(12, 19, 28, 0.08),
      0 1px 0 rgba(255, 255, 255, 0.8) inset,
      0 -1px 0 rgba(12, 19, 28, 0.04) inset;
  }

  @supports not (
    (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))
  ) {
    .nav-glass {
      background: rgba(245, 245, 245, 0.92);
    }
  }
</style>
