---
import { Image } from "astro:assets";
import type { Project } from "@/data/projects";
import ExternalLink from "../common/ExternalLink.astro";
import Divider from "../common/Divider.astro";
import ConnectButton from "../common/ConnectButton.astro";
import MailIcon from "@/assets/icons/mail-icon.svg";
import ImageGallery from "../common/ImageGallery.astro";
import { getProjectBySlug } from "@/data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;

// Get related projects
const relatedProjects = project.relatedProjects
  ?.map((slug) => getProjectBySlug(slug))
  .filter((p): p is Project => p !== undefined) || [];
---

<!-- Reading Progress Bar -->
<div id="reading-progress" class="fixed top-0 left-0 w-full h-[3px] bg-black/5 z-50">
  <div id="progress-bar" class="h-full bg-gradient-to-r from-tertiaryBg via-purple-500 to-pink-500 transition-all duration-150 ease-out" style="width: 0%"></div>
</div>

<section class="flex flex-col gap-[60px] sm:gap-[100px] pb-[100px] relative">
  
  <!-- Floating Quick Nav -->
  <div class="fixed right-[40px] top-[50%] translate-y-[-50%] z-40 hidden xl:flex flex-col gap-[12px]" id="quick-nav">
    <a href="#overview" class="nav-dot group relative" data-section="overview">
      <div class="w-[12px] h-[12px] rounded-full bg-black/20 group-hover:bg-tertiaryBg transition-all duration-300 group-hover:scale-150"></div>
      <span class="absolute right-[24px] top-[50%] translate-y-[-50%] bg-textPrimary text-white px-[12px] py-[6px] rounded-[8px] text-[12px] font-medium opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap">Overview</span>
    </a>
    <a href="#impact" class="nav-dot group relative" data-section="impact">
      <div class="w-[12px] h-[12px] rounded-full bg-black/20 group-hover:bg-tertiaryBg transition-all duration-300 group-hover:scale-150"></div>
      <span class="absolute right-[24px] top-[50%] translate-y-[-50%] bg-textPrimary text-white px-[12px] py-[6px] rounded-[8px] text-[12px] font-medium opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap">Impact</span>
    </a>
    <a href="#solution" class="nav-dot group relative" data-section="solution">
      <div class="w-[12px] h-[12px] rounded-full bg-black/20 group-hover:bg-tertiaryBg transition-all duration-300 group-hover:scale-150"></div>
      <span class="absolute right-[24px] top-[50%] translate-y-[-50%] bg-textPrimary text-white px-[12px] py-[6px] rounded-[8px] text-[12px] font-medium opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap">Solution</span>
    </a>
    <a href="#visuals" class="nav-dot group relative" data-section="visuals">
      <div class="w-[12px] h-[12px] rounded-full bg-black/20 group-hover:bg-tertiaryBg transition-all duration-300 group-hover:scale-150"></div>
      <span class="absolute right-[24px] top-[50%] translate-y-[-50%] bg-textPrimary text-white px-[12px] py-[6px] rounded-[8px] text-[12px] font-medium opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap">Visuals</span>
    </a>
  </div>

  <!-- HERO SECTION - Enhanced -->
  <div class="flex flex-col gap-[24px] relative">
    <!-- Back Navigation -->
    <div class="absolute top-[-60px] left-0 z-10 hidden lg:block">
      <a
        href="/"
        class="group flex items-center gap-[12px] text-textSecondary hover:text-textPrimary transition-all duration-300"
      >
        <div class="w-[48px] h-[48px] rounded-full bg-white border border-black/5 flex items-center justify-center shadow-sm group-hover:shadow-md group-hover:scale-110 transition-all duration-300">
           <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" class="text-textPrimary">
             <path d="M12.5 15L7.5 10L12.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
           </svg>
        </div>
      </a>
    </div>

    <div class="relative w-full h-[85vh] min-h-[600px] rounded-[32px] sm:rounded-[48px] overflow-hidden shadow-2xl group" id="hero-section">
      <!-- Animated Background Gradient -->
      <div class="absolute inset-0 bg-gradient-to-br from-tertiaryBg/20 via-purple-500/20 to-pink-500/20 animate-gradient-shift"></div>
      
      <Image
        src={project.image1}
        alt={project.title}
        class="w-full h-full object-cover parallax-image scale-105 mix-blend-overlay"
        loading="eager"
        fetchpriority="high"
      />
      
      <!-- Enhanced Cinematic Overlay -->
      <div class="absolute inset-0 bg-gradient-to-t from-black via-black/60 to-transparent flex flex-col justify-end p-[32px] sm:p-[60px] lg:p-[80px]">
        <div class="apple-reveal max-w-[1200px]">
           <!-- Enhanced Badge System -->
           <div class="flex flex-wrap items-center gap-[12px] mb-[32px]">
              {project.role && (
                <span class="px-[20px] py-[10px] rounded-full bg-gradient-to-r from-tertiaryBg to-blue-400 backdrop-blur-md border border-white/20 text-white text-[14px] font-bold uppercase tracking-widest shadow-lg animate-badge-glow">
                  {project.role}
                </span>
              )}
              {project.year && (
                <span class="px-[18px] py-[10px] rounded-full bg-white/10 backdrop-blur-xl border border-white/20 text-white text-[14px] font-semibold">
                  {project.year}
                </span>
              )}
              {project.technologies && project.technologies.slice(0, 3).map(tech => (
                <span class="px-[16px] py-[8px] rounded-full bg-black/40 backdrop-blur-md border border-white/10 text-white/70 text-[13px] font-medium">
                  {tech}
                </span>
              ))}
           </div>
           
          <h1 class="text-white text-[52px] sm:text-[84px] md:text-[112px] lg:text-[128px] font-black leading-[0.9] tracking-tighter mb-[32px] hero-title">
            {project.title}
          </h1>
          
          <p class="text-white/90 text-[20px] sm:text-[28px] font-light max-w-[800px] leading-relaxed mb-[40px]">
            {project.shortDescription}
          </p>

          <!-- Hero Actions -->
          <div class="flex flex-wrap gap-[16px]">
            {project.link && (
              <a href={project.link} target="_blank" rel="noopener noreferrer" class="group/btn px-[32px] py-[16px] bg-white text-textPrimary rounded-full font-bold text-[16px] hover:bg-tertiaryBg hover:text-white transition-all duration-300 shadow-xl hover:shadow-2xl hover:scale-105 flex items-center gap-[12px]">
                View Live Project
                <svg class="w-[20px] h-[20px] group-hover/btn:translate-x-1 group-hover/btn:translate-y-[-2px] transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M7 17L17 7M17 7H7M17 7V17"/>
                </svg>
              </a>
            )}
            <a href="#overview" class="px-[32px] py-[16px] bg-white/10 backdrop-blur-xl text-white border-2 border-white/30 rounded-full font-bold text-[16px] hover:bg-white/20 transition-all duration-300 flex items-center gap-[12px]">
              Explore Details
              <svg class="w-[20px] h-[20px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 5v14M19 12l-7 7-7-7"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Scroll Indicator -->
      <div class="absolute bottom-[40px] left-[50%] translate-x-[-50%] animate-bounce">
        <div class="w-[30px] h-[50px] rounded-full border-2 border-white/50 flex items-start justify-center p-[6px]">
          <div class="w-[6px] h-[10px] bg-white/70 rounded-full animate-scroll-dot"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- MAIN GRID LAYOUT -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-[60px] lg:gap-[80px]">
    
    <!-- LEFT COLUMN: NARRATIVE -->
    <div class="lg:col-span-8 flex flex-col gap-[100px]">
      
      <!-- Context & Overview -->
      <div id="overview" class="flex flex-col gap-[40px] apple-reveal-section scroll-mt-[100px]">
         <div class="flex flex-col gap-[24px]">
            <div class="flex items-center gap-[16px]">
              <div class="w-[60px] h-[4px] bg-gradient-to-r from-tertiaryBg to-transparent rounded-full"></div>
              <span class="text-tertiaryBg font-black uppercase tracking-widest text-[14px]">The Story</span>
            </div>
            <h2 class="text-[36px] sm:text-[56px] font-black text-textPrimary leading-[1.05] tracking-tight">
              Overview
            </h2>
         </div>
         <div class="relative">
           <!-- Decorative Quote Mark -->
           <div class="absolute top-[-20px] left-[-20px] text-[120px] text-tertiaryBg/10 font-serif leading-none">"</div>
           <div class="prose prose-xl max-w-prose text-textSecondary leading-relaxed text-[20px] sm:text-[22px] relative z-10">
              <p class="first-letter:text-[72px] first-letter:font-bold first-letter:text-tertiaryBg first-letter:float-left first-letter:mr-[12px] first-letter:leading-none first-letter:mt-[8px]">
                {project.fullDescription}
              </p>
           </div>
         </div>
      </div>

      <!-- Video Demo Section -->
      {(project as any).videoDemo && (
         <div class="apple-reveal-section flex flex-col gap-[24px]">
            <h3 class="text-[24px] font-bold text-textPrimary">Watch Demo</h3>
            <div class="w-full rounded-[24px] overflow-hidden shadow-2xl border border-black/10 bg-black/5 aspect-video relative group hover:scale-[1.01] transition-transform duration-500 ease-out">
                <!-- Mac Window Header -->
                <div class="absolute top-0 left-0 right-0 h-[40px] bg-white/90 backdrop-blur-sm border-b border-black/5 flex items-center px-[16px] gap-[8px] z-10">
                    <div class="w-[12px] h-[12px] rounded-full bg-[#FF5F56] border border-black/5"></div>
                    <div class="w-[12px] h-[12px] rounded-full bg-[#FFBD2E] border border-black/5"></div>
                    <div class="w-[12px] h-[12px] rounded-full bg-[#27C93F] border border-black/5"></div>
                </div>
                <video 
                    src={(project as any).videoDemo} 
                    class="w-full h-full object-cover pt-[40px]" 
                    controls 
                    playsinline
                    poster={project.image1.src}
                >
                    Your browser does not support the video tag.
                </video>
            </div>
         </div>
      )}

      <!-- Impact Stats (Grid) - Enhanced with Animation -->
      {project.metrics && project.metrics.length > 0 && (
        <div id="impact" class="scroll-mt-[100px] flex flex-col gap-[40px] apple-reveal-section">
          <div class="flex flex-col gap-[20px]">
            <div class="flex items-center gap-[16px]">
              <div class="w-[60px] h-[4px] bg-gradient-to-r from-purple-500 to-transparent rounded-full"></div>
              <span class="text-purple-600 font-black uppercase tracking-widest text-[14px]">Impact</span>
            </div>
            <h2 class="text-[36px] sm:text-[48px] font-black text-textPrimary leading-[1.1]">
              By The Numbers
            </h2>
          </div>
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-[24px]">
            {project.metrics.map((metric, index) => (
              <div class="metric-card group relative bg-gradient-to-br from-white to-surface p-[40px] rounded-[40px] flex flex-col gap-[12px] border-2 border-black/5 hover:border-tertiaryBg/40 transition-all duration-500 hover:translate-y-[-8px] hover:shadow-2xl overflow-hidden">
                <!-- Animated Background -->
                <div class="absolute inset-0 bg-gradient-to-br from-tertiaryBg/5 to-purple-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                
                <!-- Icon Badge -->
                <div class="absolute top-[20px] right-[20px] w-[40px] h-[40px] rounded-full bg-tertiaryBg/10 flex items-center justify-center text-tertiaryBg text-[20px] font-bold opacity-0 group-hover:opacity-100 transition-all duration-500 group-hover:scale-110">
                  {index + 1}
                </div>
                
                <div class="relative z-10">
                  <span 
                    class="counter text-[56px] sm:text-[72px] font-black bg-gradient-to-br from-textPrimary to-tertiaryBg bg-clip-text text-transparent leading-[1] block"
                    data-target={metric.value}
                  >
                    0
                  </span>
                  <span class="text-textSecondary font-bold text-[15px] uppercase tracking-widest mt-[8px] block">
                    {metric.label}
                  </span>
                </div>

                <!-- Decorative Element -->
                <div class="absolute bottom-0 left-0 w-full h-[4px] bg-gradient-to-r from-tertiaryBg via-purple-500 to-pink-500 scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left"></div>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Problem & Solution (Visual Grid) - Enhanced -->
      {(project.problemStatement || project.solution) && (
        <div id="solution" class="scroll-mt-[100px] flex flex-col gap-[32px] apple-reveal-section">
           {project.problemStatement && (
             <div class="group relative bg-gradient-to-br from-red-50 to-orange-50 p-[48px] rounded-[48px] border-2 border-red-200/50 hover:border-red-400 transition-all duration-500 hover:shadow-[0_20px_60px_rgba(239,68,68,0.15)] overflow-hidden">
                <!-- Animated Background Pattern -->
                <div class="absolute inset-0 opacity-[0.03]" style="background-image: repeating-linear-gradient(45deg, #ef4444 0, #ef4444 1px, transparent 0, transparent 50%); background-size: 20px 20px;"></div>
                
                <!-- Animated Icon -->
                <div class="absolute top-[30px] right-[30px] opacity-10 group-hover:opacity-20 transition-all duration-500 group-hover:rotate-12 group-hover:scale-110">
                    <svg width="160" height="160" viewBox="0 0 24 24" fill="currentColor" class="text-red-500">
                      <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
                    </svg>
                </div>
                
                <div class="relative z-10">
                  <!-- Badge -->
                  <div class="inline-flex items-center gap-[12px] bg-red-500 text-white px-[24px] py-[12px] rounded-full text-[14px] font-bold uppercase tracking-wider mb-[24px] shadow-lg">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <circle cx="12" cy="12" r="10"/>
                      <line x1="12" y1="8" x2="12" y2="12"/>
                      <line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                    The Challenge
                  </div>
                  
                  <p class="text-[20px] sm:text-[24px] leading-relaxed text-gray-800 max-w-prose font-medium">
                    {project.problemStatement}
                  </p>
                </div>

                <!-- Decorative Corner -->
                <div class="absolute bottom-0 left-0 w-[120px] h-[120px] bg-gradient-to-br from-red-400/20 to-transparent rounded-tr-full"></div>
             </div>
           )}
           
           {project.solution && (
             <div class="group relative bg-gradient-to-br from-emerald-50 to-teal-50 p-[48px] rounded-[48px] border-2 border-emerald-200/50 hover:border-tertiaryBg transition-all duration-500 hover:shadow-[0_20px_60px_rgba(0,209,232,0.15)] overflow-hidden">
                <!-- Animated Background Pattern -->
                <div class="absolute inset-0 opacity-[0.03]" style="background-image: repeating-linear-gradient(-45deg, #00d1e8 0, #00d1e8 1px, transparent 0, transparent 50%); background-size: 20px 20px;"></div>
                
                <!-- Animated Icon -->
                <div class="absolute top-[30px] right-[30px] opacity-10 group-hover:opacity-20 transition-all duration-500 group-hover:scale-110">
                    <svg width="160" height="160" viewBox="0 0 24 24" fill="currentColor" class="text-tertiaryBg">
                      <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                    </svg>
                </div>
                
                <div class="relative z-10">
                  <!-- Badge -->
                  <div class="inline-flex items-center gap-[12px] bg-gradient-to-r from-tertiaryBg to-emerald-500 text-white px-[24px] py-[12px] rounded-full text-[14px] font-bold uppercase tracking-wider mb-[24px] shadow-lg">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                      <polyline points="22 4 12 14.01 9 11.01"/>
                    </svg>
                    The Solution
                  </div>
                  
                  <p class="text-[20px] sm:text-[24px] leading-relaxed text-gray-800 max-w-prose font-medium">
                    {project.solution}
                  </p>
                </div>

                <!-- Decorative Corner -->
                <div class="absolute bottom-0 right-0 w-[120px] h-[120px] bg-gradient-to-tl from-tertiaryBg/20 to-transparent rounded-tl-full"></div>
             </div>
           )}
        </div>
      )}

      <!-- Visual Deep Dive - Enhanced -->
      <div id="visuals" class="scroll-mt-[100px] flex flex-col gap-[60px] apple-reveal-section">
         <div class="flex flex-col gap-[24px]">
            <div class="flex items-center gap-[16px]">
              <div class="w-[60px] h-[4px] bg-gradient-to-r from-pink-500 to-transparent rounded-full"></div>
              <span class="text-pink-600 font-black uppercase tracking-widest text-[14px]">Visuals</span>
            </div>
            <h2 class="text-[36px] sm:text-[56px] font-black text-textPrimary leading-[1.05]">
              Interface Design
            </h2>
            <p class="text-[18px] text-textSecondary max-w-[600px]">
              Every pixel crafted with purpose. Explore the visual journey of this project.
            </p>
         </div>

         <!-- Featured Image with Device Frame -->
         <div class="relative group">
            <!-- MacBook Frame -->
            <div class="bg-gradient-to-br from-gray-800 via-gray-900 to-black p-[20px] sm:p-[32px] rounded-[32px] shadow-2xl hover:shadow-[0_30px_80px_rgba(0,0,0,0.25)] transition-all duration-700 hover:scale-[1.01]">
              <!-- Screen Bezel -->
              <div class="bg-black p-[8px] rounded-[20px] relative overflow-hidden">
                <!-- Camera Notch -->
                <div class="absolute top-0 left-[50%] translate-x-[-50%] w-[120px] h-[20px] bg-black rounded-b-[12px] z-20 flex items-center justify-center">
                  <div class="w-[6px] h-[6px] rounded-full bg-gray-700"></div>
                </div>
                
                <!-- Screen Content -->
                <div class="rounded-[16px] overflow-hidden bg-white relative">
                  <Image 
                    src={project.image2} 
                    alt="Main Interface" 
                    class="w-full h-auto object-cover transition-transform duration-1000 group-hover:scale-[1.03]" 
                  />
                  
                  <!-- Hover Overlay -->
                  <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end justify-center pb-[40px]">
                    <span class="text-white font-bold text-[16px] bg-white/20 backdrop-blur-md px-[24px] py-[12px] rounded-full border border-white/30">
                      Click to expand
                    </span>
                  </div>
                </div>
              </div>
              
              <!-- MacBook Base -->
              <div class="h-[20px] bg-gradient-to-b from-gray-700 to-gray-800 rounded-b-[24px] mt-[8px] relative">
                <div class="absolute top-[50%] left-[50%] translate-x-[-50%] translate-y-[-50%] w-[60px] h-[4px] bg-gray-600 rounded-full"></div>
              </div>
            </div>

            <!-- Floating Labels -->
            <div class="absolute top-[40px] left-[-20px] bg-white px-[20px] py-[10px] rounded-full shadow-lg text-[14px] font-bold text-textPrimary opacity-0 group-hover:opacity-100 transition-all duration-500 group-hover:translate-x-[10px]">
              ✨ Responsive
            </div>
            <div class="absolute bottom-[60px] right-[-20px] bg-tertiaryBg text-white px-[20px] py-[10px] rounded-full shadow-lg text-[14px] font-bold opacity-0 group-hover:opacity-100 transition-all duration-500 group-hover:translate-x-[-10px]">
              Modern UI
            </div>
         </div>

         <!-- Enhanced Gallery Grid -->
         <div class="grid grid-cols-1 md:grid-cols-2 gap-[24px]">
            <div class="group relative rounded-[32px] overflow-hidden aspect-[4/3] shadow-xl hover:shadow-2xl transition-all duration-500">
              <Image 
                src={project.image1} 
                alt={`${project.title} - View 1`} 
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" 
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
              <div class="absolute bottom-[24px] left-[24px] text-white font-bold text-[18px] opacity-0 group-hover:opacity-100 transition-all duration-500 translate-y-[10px] group-hover:translate-y-0">
                Primary View
              </div>
            </div>
            
            <div class="group relative rounded-[32px] overflow-hidden aspect-[4/3] shadow-xl hover:shadow-2xl transition-all duration-500">
              <Image 
                src={project.image2} 
                alt={`${project.title} - View 2`} 
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" 
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
              <div class="absolute bottom-[24px] left-[24px] text-white font-bold text-[18px] opacity-0 group-hover:opacity-100 transition-all duration-500 translate-y-[10px] group-hover:translate-y-0">
                Detail Shot
              </div>
            </div>
         </div>

         <!-- Full Gallery Component -->
         <ImageGallery images={[project.image1, project.image2]} altPrefix={project.title} />
      </div>

      <!-- Process & Timeline - Enhanced -->
      {project.process && project.process.length > 0 && (
        <div class="flex flex-col gap-[50px] apple-reveal-section">
          <div class="flex flex-col gap-[24px]">
            <div class="flex items-center gap-[16px]">
              <div class="w-[60px] h-[4px] bg-gradient-to-r from-orange-500 to-transparent rounded-full"></div>
              <span class="text-orange-600 font-black uppercase tracking-widest text-[14px]">Process</span>
            </div>
            <h2 class="text-[36px] sm:text-[56px] font-black text-textPrimary leading-[1.05]">
              How We Built It
            </h2>
          </div>

          <div class="relative">
            <!-- Animated Progress Line -->
            <div class="absolute left-[24px] top-[30px] bottom-[30px] w-[4px] bg-gradient-to-b from-tertiaryBg via-purple-500 to-pink-500 rounded-full progress-line"></div>
            <div class="absolute left-[24px] top-[30px] bottom-[30px] w-[4px] bg-black/5 rounded-full"></div>
            
            <div class="flex flex-col gap-[48px]">
               {project.process.map((step, index) => (
                  <div class="relative group pl-[80px] process-step" data-step={index}>
                     <!-- Animated Node -->
                     <div class="absolute left-[8px] top-[8px] w-[32px] h-[32px] rounded-full bg-white border-[4px] border-tertiaryBg shadow-lg transition-all duration-500 group-hover:scale-150 group-hover:rotate-180 z-10 flex items-center justify-center">
                        <span class="text-[12px] font-bold text-tertiaryBg">{index + 1}</span>
                     </div>
                     
                     <!-- Glow Effect -->
                     <div class="absolute left-[8px] top-[8px] w-[32px] h-[32px] rounded-full bg-tertiaryBg/30 blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

                     <!-- Content Card -->
                     <div class="bg-gradient-to-br from-white to-surface p-[32px] rounded-[32px] border-2 border-black/5 group-hover:border-tertiaryBg/30 transition-all duration-500 group-hover:shadow-xl group-hover:translate-x-[8px]">
                        <div class="flex items-start justify-between gap-[20px] mb-[12px]">
                           <h4 class="text-[22px] font-bold text-textPrimary transition-colors duration-300 group-hover:text-tertiaryBg flex-1">
                              {step}
                           </h4>
                           <span class="px-[16px] py-[6px] bg-tertiaryBg/10 text-tertiaryBg rounded-full text-[13px] font-bold whitespace-nowrap">
                              Phase {index + 1}
                           </span>
                        </div>
