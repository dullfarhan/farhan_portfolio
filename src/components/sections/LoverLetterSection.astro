---
import { Image } from "astro:assets";
import Divider from "../common/Divider.astro";
import LoverLetterCard from "../common/LoveLetterCard.astro";
import shahzeb from "@/assets/images/love-letters/shahzeb.jpeg";
import talha from "@/assets/images/love-letters/talha.jpeg";
import ahmed from "@/assets/images/love-letters/ahmed.png";
import zach from "@/assets/images/love-letters/zach.jpeg";
import heart from "@/assets/icons/love-letter.svg";
const testimonials = [
  {
    title: "Their attention to detail really shows in the code.",
    message:
      "DaanFr has been an incredible support to our team. They not only helped us solve a complex optimization problem but also took the time to train and guide our engineers, leaving them more confident and skilled. The team is well-versed, highly organized, and most importantly, reliable. What stands out about DaanFr is their approach—they don't shy away from challenges. Instead, they embrace problems, break them down, and deliver the best possible solutions. Their consistency and professionalism make them a partner you can truly depend on. I would strongly recommend DaanFr to anyone looking for a skilled, committed, and trustworthy engineering partner.",
    name: "Ahmed Waheed",
    role: "CEO at AskUs Solution",
    love_letter_link: "",
    lover_link: "",
    image: ahmed,
  },
  {
    title: "You can tell they think before they code",
    message:
      "DaanFr worked with us as a Full Stack Development partner for approximately two years. They are a highly skilled and dedicated team that consistently delivers quality results. Their ability to set and achieve goals, combined with strong problem-solving skills, makes them an invaluable asset to any project. DaanFr is not only talented but also a true strategic partner—they remain committed to the project until completion, ensuring collaboration and success. Any company would be fortunate to work with them",
    name: "Muhammad Talha Khan",
    role: "Sr Manager at Walqalum",
    love_letter_link: "https://www.linkedin.com/in/dullfarhan/",
    lover_link: "Muhammad Talha Khan",
    image: talha,
  },
  {
    title: "They made the complex feel simple",
    message:
      "Working with DaanFr has been an exceptional experience. They not only integrated all the changes in our codebase flawlessly, but also went above and beyond in assisting with additional tasks and ensuring that all documentation was thorough and well-organized. Their attention to detail, responsiveness, and commitment to the project were outstanding. DaanFr's work ethic and proactive approach made a significant impact on the success of our development efforts. Highly recommended, and we look forward to working with them again!",
    name: "Shahzeb Ali",
    role: "CEO at Develmo",
    love_letter_link:
      "https://www.upwork.com/ab/g/pub/wom/prx/eyJwZXJzb25VaWQiOiIxNzI4NDUzMzMyNTcyMzQ0MzIwIiwiY29udHJhY3RSaWQiOiI0MDE1MjE0NCIsImJhbm5lclR5cGUiOiJjb250cmFjdCIsImJhbm5lclZhcmlhbnQiOiJkZWZhdWx0Iiwid29tIjoiZmx2MiIsInJlZGlyZWN0IjoiZmxfcHJvZmlsZV9wcm9tbyJ9",
    lover_link: "https://www.linkedin.com/in/shahzebdata/",
    image: shahzeb,
  },
  {
    title: "Their attention to detail really shows in the code.",
    message:
      "DaanFr handled both front-end and back-end with care and precision. Even under pressure, they delivered clean, thoughtful solutions. They are a team you can rely on to quietly raise the bar without making a fuss.",
    name: "Zachary Waugaman",
    role: "Co-Founder of Fullframe",
    love_letter_link: "",
    lover_link: "",
    image: zach,
  },
];
---

<section class="">
  <div class="flex flex-col gap-[20px] sm:gap-[32px]">
    <div class="flex flex-col gap-[12px] sm:gap-[16px]">
      <div class="flex justify-center items-center gap-[14px] sm:gap-[16px]">
        <h2>Client Testimonials</h2>
        <Image
          src={heart}
          alt="Super Icon"
          class="w-[20px] h-[32px] sm:w-[30px] sm:h-[48px]"
        />
      </div>
      <p
        class="text-center text-[14px] sm:text-[20px] align-bottom mx-auto w-[334px] md:w-auto"
      >
        Because somewhere between the bugs and builds, our team made magic
        happen.
      </p>
    </div>
    <div class="flex flex-wrap justify-center gap-[20px] sm:gap-[23.5px]">
      {
        testimonials.map((t) => (
          <LoverLetterCard
            title={t.title}
            message={t.message}
            name={t.name}
            role={t.role}
            image={t.image}
          />
        ))
      }
    </div>
  </div>
</section>
<Divider />
