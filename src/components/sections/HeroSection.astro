---
import { Image } from "astro:assets";
import HeroTitle from "../common/HeroTitle.astro";
import HeroIcons from "../common/HeroIcons.astro";
import HeroCTA from "../common/HeroCTA.astro";
import Divider from "../common/Divider.astro";
import heroImage from "@/assets/images/hero.png";
---

<section class="flex flex-col gap-8 sm:gap-10 lg:gap-12 py-6 md:py-10 mb-[20px] sm:mb-[40px]">
  <div
    class="flex flex-col xl:flex-row items-center justify-between gap-8 sm:gap-10 lg:gap-12"
  >
    <div
      class="flex flex-col items-center xl:items-start gap-[24px] sm:gap-[40px]"
    >
      <HeroTitle />
      <HeroCTA />
    </div>
    <div class="flex items-center justify-center w-full lg:w-1/2">
      <Image
        src={heroImage}
        alt="3D illustration of code, cloud, and AI tools"
        class="w-full max-w-[280px] sm:max-w-[420px] lg:max-w-[520px] h-auto object-contain"
        loading="eager"
        widths={[280, 420, 520, 800]}
        sizes="(max-width: 640px) 280px, (max-width: 1024px) 420px, 520px"
      />
    </div>
  </div>
  <HeroIcons />
</section>

