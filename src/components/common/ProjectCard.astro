---
// ProjectCard.astro
import { Image } from "astro:assets";
import ExternalLinkIcon from "@/assets/icons/external.svg";

export interface Props {
  index: number;
  title: string;
  description: string;
  image1: ImageMetadata;
  image2: ImageMetadata;
  tags: string[];
  category: string;
  link?: string;
}

const { title, description, image1, image2, tags, category, index, link } =
  Astro.props;
const isFirstIndex = index === 0;
---

<div
  class="card group relative overflow-hidden project-card"
  data-category={category}
  data-title={title}
  data-description={description}
  data-tags={tags.join(" ")}
>
  <div class="relative w-full max-w-[320px] sm:max-w-[438px] aspect-[4/3] overflow-hidden rounded-[18px] sm:rounded-[20px]">
    <Image
      src={image1}
      alt={title}
      width={438}
      height={263}
      widths={[350, 700, 1050]}
      sizes="(max-width: 640px) 100vw, 350px"
      format="webp"
      quality={90}
      priority={isFirstIndex}
      loading={isFirstIndex ? "eager" : "lazy"}
      decoding="async"
      class={`w-full h-full object-cover transition-all duration-500 group-hover:scale-[1.03] ${
        !isFirstIndex ? "group-hover:opacity-0" : ""
      }`}
    />
    {
      !isFirstIndex && (
        <Image
          src={image2}
          alt={title}
          width={438}
          height={263}
          widths={[350, 700, 1050]}
          sizes="(max-width: 640px) 100vw, 350px"
          format="webp"
          quality={90}
          decoding="async"
          class="absolute inset-0 w-full h-full object-cover opacity-0 transition-all duration-500 group-hover:opacity-100 group-hover:scale-[1.03]"
        />
      )
    }

    <!-- Title + link overlaid on image -->
    <div
      class="absolute inset-x-0 bottom-0 z-10 flex flex-col justify-end bg-gradient-to-t from-black/70 via-black/35 to-transparent px-3 pb-3 pt-12 sm:px-4 sm:pb-4"
    >
      {
        link ? (
          <a
            href={link}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-white transition-all duration-200 ease-in-out hover:underline hover:underline-offset-4 hover:decoration-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-blue-500 focus-visible:rounded-sm"
            aria-label={`${title} (opens in new tab)`}
          >
            <h3 class="text-[18px] sm:text-[20px] font-semibold text-white">
              {title}
            </h3>
            <span class="w-4 h-4 shrink-0 text-white transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
              <ExternalLinkIcon />
            </span>
          </a>
        ) : (
          <h3 class="text-[18px] sm:text-[20px] font-semibold text-white">
            {title}
          </h3>
        )
      }
    </div>
  </div>

  <div
    class="flex flex-col gap-[16px] p-0 sm:pr-[10px] sm:pb-[10px] sm:pl-[10px]"
  >
    <p class="leading-[1.2] text-sm sm:text-base">{description}</p>
    <div class="flex flex-wrap gap-[10px]">
      {
        tags.map((tag) => (
          <span class="pill-glass text-[12px] sm:text-[14px] font-normal px-[12px] py-[8px] rounded-full leading-[100%]">
            {tag}
          </span>
        ))
      }
    </div>
  </div>
</div>

<style>
  .pill-glass {
    background: rgba(255, 255, 255, 0.45);
    backdrop-filter: blur(12px) saturate(160%);
    -webkit-backdrop-filter: blur(12px) saturate(160%);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.8) inset,
      0 -1px 0 rgba(12, 19, 28, 0.09) inset;
  }

  @supports not (
    (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))
  ) {
    .pill-glass {
      background: rgba(255, 255, 255, 0.25);
    }
  }
</style>
