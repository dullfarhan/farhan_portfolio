---
interface Props {
  step: string;
  index: number;
  isLast?: boolean;
}

const { step, index, isLast = false } = Astro.props;
---

<div class="flex gap-[20px] sm:gap-[24px]">
  <!-- Timeline Line -->
  <div class="flex flex-col items-center">
    <div class="w-[40px] h-[40px] sm:w-[48px] sm:h-[48px] rounded-full bg-tertiaryBg flex items-center justify-center flex-shrink-0 border-4 border-white shadow-[0_4px_12px_rgba(0,209,232,0.3)]">
      <span class="text-white font-semibold text-[14px] sm:text-[16px]">{index + 1}</span>
    </div>
    {!isLast && (
      <div class="w-[2px] flex-1 bg-gradient-to-b from-tertiaryBg to-tertiaryBg/20 my-[8px]"></div>
    )}
  </div>
  
  <!-- Step Content -->
  <div class="flex-1 pb-[32px] sm:pb-[40px]">
    <div class="bg-surface rounded-[20px] p-[20px] sm:p-[24px] hover:shadow-[0_4px_16px_rgba(0,0,0,0.1)] transition-shadow duration-300">
      <h4 class="text-textPrimary font-semibold text-[16px] sm:text-[18px] mb-[8px]">
        {step}
      </h4>
    </div>
  </div>
</div>





